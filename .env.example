# Copy to .env before starting Docker Compose. Keep this file free of real secrets.
DATABASE_PASSWORD=intelhub
REDIS_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-change-me
# Version-pinned community rebuild of MinIO; override with a trusted internal mirror if needed.
MINIO_IMAGE=alpine/minio:RELEASE.2025-10-15T17-29-55Z
FRONTEND_PORT=8080
MINIO_CONSOLE_PORT=19001

# Local demo tuning; these are shared by both backend instances.
CHAT_MAX_CONCURRENT=4
CHAT_MAX_WAIT_SECONDS=30
CHAT_PERMIT_LEASE_SECONDS=600
CHAT_MODEL_FAILURE_THRESHOLD=3
CHAT_MODEL_CIRCUIT_COOLDOWN_MILLIS=30000
EMBEDDING_DIMENSION=384
RAG_MIN_VECTOR_SIMILARITY=0.25
RAG_MIN_LEXICAL_OVERLAP=0.1
ROCKETMQ_SEND_MESSAGE_TIMEOUT=10000

# Leave both empty to use the built-in evidence-grounded demo fallback.
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
# Cohere-compatible rerank endpoint; set base URL (or full /rerank endpoint), key, and model.
AI_RERANK_BASE_URL=
AI_RERANK_API_KEY=
AI_RERANK_MODEL=

# Optional: bootstrap the first admin at startup. No default demo account is created.
INTELHUB_ADMIN_USERNAME=
INTELHUB_ADMIN_PASSWORD=
